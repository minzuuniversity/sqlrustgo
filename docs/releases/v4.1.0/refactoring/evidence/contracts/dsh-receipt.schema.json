{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentRunReceipt",
  "type": "object",
  "required": ["receipt_id", "task_id", "run_id", "harness", "status", "created_at"],
  "additionalProperties": false,
  "properties": {
    "receipt_id": {"type": "string", "description": "receipt-<hex12>；与 runs.run_id 1:1"},
    "task_id": {"type": "string"},
    "run_id": {"type": "string"},
    "harness": {"type": "string"},
    "model": {"type": "string"},
    "resource_id": {"type": "string"},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "TIMEOUT", "CANCELLED", "SKIPPED", "UNKNOWN"]},
    "exit_code": {"type": "integer", "description": "对齐 ai-project-hub receipts.jsonl 的 exit 字段口径（0=PASS,124=TIMEOUT,127=OSError）"},
    "duration_s": {"type": "number"},
    "stdout_tail": {"type": "string", "maxLength": 2000, "description": "对齐旧 receipts 的 stdout_tail ≤2000"},
    "stderr_tail": {"type": "string", "maxLength": 1000},
    "worktree": {"type": "string"},
    "branch": {"type": "string"},
    "head_commit": {"type": "string"},
    "base_commit": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {"type": "object", "required": ["kind", "ref"], "properties": {
        "kind": {"type": "string", "enum": ["test_log", "diff", "ci_run", "gate_decision", "review_report"]},
        "ref": {"type": "string"}
      }}
    },
    "hub_ref": {"type": "object", "description": "与 ai-project-hub 的关联（可空）", "properties": {
      "decision_id": {"type": "string", "description": "opencode_shadow._decision_id 口径"},
      "hub_task_key": {"type": "string", "description": "task:<project>:<task> 租约键口径"},
      "session": {"type": "string"}
    }},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
